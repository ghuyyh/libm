<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainpane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdm.controller.TitleCopyManage">
   <top>
      <AnchorPane prefHeight="0.0" prefWidth="709.0" style="-fx-background-color: #ffffff;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="709.0" AnchorPane.bottomAnchor="7.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0">
               <children>
                  <Button fx:id="home" mnemonicParsing="false" onAction="#homeClick" styleClass="round-button" text="Home" />
                  <Pane prefHeight="46.0" prefWidth="23.0" />
                  <MenuButton mnemonicParsing="false" prefHeight="27.0" prefWidth="49.0" styleClass="round-button" text="☰" textAlignment="CENTER">
                     <items>
                        <MenuItem fx:id="book" mnemonicParsing="false" onAction="#bookClick" text="Book Catalog" />
                        <MenuItem fx:id="members" mnemonicParsing="false" onAction="#memClick" text="Members Manage" />
                        <MenuItem fx:id="loans" mnemonicParsing="false" onAction="#loanClick" text="Loans Manage" />
                        <MenuItem fx:id="reservations" mnemonicParsing="false" onAction="#reserClick" text="Reservations" />
                        <MenuItem fx:id="fines" mnemonicParsing="false" onAction="#fineClick" text="Fines" />
                        <MenuItem fx:id="report" mnemonicParsing="false" onAction="#reportClick" text="Report" />
                     </items>
                  </MenuButton>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Library Management System" textAlignment="CENTER">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Text>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Pane>
                  <Button fx:id="search" mnemonicParsing="false" onAction="#searchClick" prefHeight="25.0" prefWidth="51.0" styleClass="round-button" text="🔎" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </top>
   <bottom>
      <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="Authors">
               <content>
                  <AnchorPane prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="auth_table" prefHeight="200.0" prefWidth="200.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                          <columns>
                            <TableColumn fx:id="col_authid" prefWidth="75.0" text="Author ID" />
                            <TableColumn fx:id="col_authname" prefWidth="348.0" text="Name" />
                              <TableColumn fx:id="col_bio" prefWidth="365.0" text="Biography" />
                          </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
               </content></Tab>
          <Tab text="Copies">
               <content>
                  <AnchorPane prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="copy_table" prefHeight="172.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                          <columns>
                            <TableColumn fx:id="col_copyid" prefWidth="75.0" text="Copy ID" />
                            <TableColumn fx:id="col_shelf" prefWidth="218.0" text="Shelf location" />
                              <TableColumn fx:id="col_status" prefWidth="130.0" text="Status" />
                              <TableColumn fx:id="col_note" prefWidth="265.0" text="notes" />
                          </columns>
                        </TableView>
                        <Button fx:id="add_copy_btn" alignment="BOTTOM_RIGHT" mnemonicParsing="false" text="add copy +" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                     </children>
                  </AnchorPane>
               </content>
          </Tab>
        </tabs>
      </TabPane>
   </bottom>
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="book_table" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="col_isbn" prefWidth="75.0" text="ISBN" />
                <TableColumn fx:id="col_title" prefWidth="402.0" text="Title" />
                  <TableColumn fx:id="col_year" prefWidth="98.0" text="Publish year" />
                  <TableColumn fx:id="col_publisher" prefWidth="124.0" text="Publisher" />
              </columns>
            </TableView>
            <Button fx:id="add_book_btn" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#addBook" text="Add book +" StackPane.alignment="BOTTOM_RIGHT">
               <StackPane.margin>
                  <Insets />
               </StackPane.margin>
            </Button>
         </children>
      </StackPane>
   </center>
</BorderPane>
