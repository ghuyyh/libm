<BorderPane fx:id="mainpane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdm.controller.FinePaymentManage">
   <top>
      <AnchorPane prefHeight="0.0" prefWidth="709.0" style="-fx-background-color: #ffffff;" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="709.0" AnchorPane.bottomAnchor="7.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0">
               <children>
                  <Button fx:id="home" mnemonicParsing="false" onAction="#homeClick" styleClass="round-button" text="Home" />
                  <Pane prefHeight="46.0" prefWidth="23.0" />
                  <MenuButton mnemonicParsing="false" prefHeight="27.0" prefWidth="49.0" styleClass="round-button" text="☰" textAlignment="CENTER">
                     <items>
                        <MenuItem fx:id="book" mnemonicParsing="false" onAction="#bookClick" text="Book Catalog" />
                        <MenuItem fx:id="members" mnemonicParsing="false" onAction="#memClick" text="Members Manage" />
                        <MenuItem fx:id="loans" mnemonicParsing="false" onAction="#loanClick" text="Loans Manage" />
                        <MenuItem fx:id="reservations" mnemonicParsing="false" onAction="#reserClick" text="Reservations" />
                        <MenuItem fx:id="fines" mnemonicParsing="false" onAction="#fineClick" text="Fines" />
                        <MenuItem fx:id="report" mnemonicParsing="false" onAction="#reportClick" text="Report" />
                     </items>
                  </MenuButton>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Library Management System" textAlignment="CENTER">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Text>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Pane>
                  <TextField fx:id="search_field" onAction="#search" promptText="Enter to search" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </top>
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="fine_table" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="col_loanid" prefWidth="75.0" text="Loan ID" />
                <TableColumn fx:id="col_memname" prefWidth="227.0" text="Member" />
                  <TableColumn fx:id="col_title" prefWidth="283.0" text="Title" />
                  <TableColumn fx:id="col_copyid" prefWidth="125.0" text="Copy ID" />
                  <TableColumn fx:id="col_status" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="col_duedate" prefWidth="173.0" text="Due Date" />
                  <TableColumn fx:id="col_returndate" prefWidth="177.0" text="Return Date" />
                  <TableColumn fx:id="col_fine_amount" prefWidth="119.0" text="Fine Amount(VND)" />
              </columns>
            </TableView>
            <Label fx:id="total_fines" style="-fx-background-color: white;" text="Total Fines: 0" StackPane.alignment="BOTTOM_RIGHT">
               <StackPane.margin>
                  <Insets bottom="2.0" right="5.0" />
               </StackPane.margin>
            </Label>
         </children>
      </StackPane>
   </center>
   <bottom>
      <TitledPane animated="false" text="Details" BorderPane.alignment="CENTER">
         <content>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #f4f4f4f4;" StackPane.alignment="BOTTOM_CENTER">
                     <items>
                        <Button alignment="CENTER" layoutX="108.0" layoutY="13.0" mnemonicParsing="false" onAction="#processPayment" text="Process Payment" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#waive" text="Waive (Cancel)" />
                     </items>
                  </ToolBar>
                  <ImageView fitHeight="92.0" fitWidth="401.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_LEFT">
                     <image>
                        <Image url="@../image/image.png" />
                     </image>
                  </ImageView>
                  <GridPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="50.0" prefWidth="250.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="193.0" minWidth="10.0" prefWidth="74.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="302.0" minWidth="10.0" prefWidth="176.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Days Late:" />
                        <Label text="Calculate:" GridPane.rowIndex="1" />
                        <Label fx:id="days_late" text="0" GridPane.columnIndex="1" />
                        <Label fx:id="calculate" text="= " GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </StackPane>
         </content>
      </TitledPane>
   </bottom>
</BorderPane>
